# Copia este archivo a .env.local y rellena los valores. Nunca versiones .env.local.

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Buzón del equipo que recibe los mensajes del formulario de contacto.
# Con el remitente de pruebas onboarding@resend.dev, Resend solo permite enviar
# al correo del propietario de la cuenta hasta que verifiques un dominio.
CONTACT_TO_EMAIL=equipo@ejemplo.com

# Remitente. Opcional: si no se define se usa "Arcade Vault <onboarding@resend.dev>".
CONTACT_FROM_EMAIL="Arcade Vault <onboarding@resend.dev>"
